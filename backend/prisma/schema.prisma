generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

////////////////////////
// TENANT (COMPANY)
////////////////////////
model Tenant {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  isActive       Boolean  @default(true)
  authMode       AuthMode @default(PASSWORD)
  allowedEmailDomains String[] @default([])
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  createdAt      DateTime @default(now())

  users         User[]
  leaves        Leave[]
  notifications Notification[]
  invitations   UserInvitation[]
  identityProviders TenantIdentityProvider[]
  externalIdentities ExternalIdentity[]
  @@map("tenants")
}

////////////////////////
// TENANT SSO CONFIG
////////////////////////
model TenantIdentityProvider {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider            SsoProvider
  clientId            String
  azureTenantId       String?
  issuer              String?
  jwksUri             String?
  authorizationUrl    String?
  tokenUrl            String?
  enabled             Boolean @default(true)
  autoProvisionUsers  Boolean @default(false)
  defaultRole         Role    @default(EMPLOYEE)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([provider, issuer])
  @@map("tenant_identity_providers")
}

////////////////////////
// EXTERNAL IDENTITIES
////////////////////////
model ExternalIdentity {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  provider         SsoProvider
  providerTenantId String @default("")
  subject          String
  email            String
  createdAt        DateTime @default(now())
  lastLoginAt      DateTime?

  @@unique([tenantId, provider, subject, providerTenantId])
  @@index([tenantId, email])
  @@index([tenantId, userId])
  @@map("external_identities")
}
////////////////////////
// USER
////////////////////////
model User {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                String
  email               String
  phone               String?
  department          String?
  position            String?
  joinDate            DateTime
  reportsToId         Int?
  reportsTo           User?            @relation("UserReportsTo", fields: [reportsToId, tenantId], references: [id, tenantId], onDelete: NoAction)
  subordinates        User[]           @relation("UserReportsTo")
  invitedUsers        UserInvitation[] @relation("InvitationReportsTo")
  leaveBalances       Json
  role                Role             @default(EMPLOYEE)
  avatar              String?
  password            String
  createdAt           DateTime         @default(now())
  refreshToken        String?
  status              String           @default("ACTIVE")

  leaves            Leave[]
  actionedLeaves    Leave[] @relation("LeaveActionedBy")
  assignedApprovals Leave[] @relation("LeaveApprover")

  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsTriggered Notification[] @relation("NotificationTriggeredBy")
  externalIdentities     ExternalIdentity[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, reportsToId])
  @@map("users")
}

////////////////////////
// LEAVE
////////////////////////
model Leave {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaveType        String
  startDate        DateTime
  endDate          DateTime
  days             Int
  reason           String
  status           LeaveStatus @default(PENDING)
  submittedAt      DateTime    @default(now())
  rejectionReason  String?
  emergencyContact String?
  emergencyPhone   String?

  userId Int
  user   User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  actionedBy     Int?
  actionedByUser User? @relation("LeaveActionedBy", fields: [actionedBy, tenantId], references: [id, tenantId], onDelete: NoAction)
  approverId     Int?
  approver       User? @relation("LeaveApprover", fields: [approverId, tenantId], references: [id, tenantId], onDelete: NoAction)

  attachments   File[]
  notifications Notification[]

  @@index([tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, approverId])
  @@index([tenantId, actionedBy])
  @@map("leaves")
}

////////////////////////
// USER INVITATIONS
////////////////////////
model UserInvitation {
  id Int @id @default(autoincrement())

  email String
  token String @unique
  role  Role

  tenantId   Int
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportsToId Int?
  reportsTo   User?  @relation("InvitationReportsTo", fields: [reportsToId, tenantId], references: [id, tenantId], onDelete: NoAction)

  expiresAt    DateTime
  used         Boolean  @default(false)
  passwordHash String?
  metadata     Json?
  createdAt    DateTime @default(now())
  // ❌ REMOVED @@map("user_invitations")

  @@index([tenantId, reportsToId])
  @@index([tenantId, email])
}

////////////////////////
// FILE ATTACHMENTS
////////////////////////
model File {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  size       Int
  type       String
  uploadedAt DateTime @default(now())

  leaveId Int?
  leave   Leave? @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@map("files")
}

////////////////////////
// NOTIFICATIONS
////////////////////////
model Notification {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  recipientId Int
  recipient   User @relation("NotificationRecipient", fields: [recipientId, tenantId], references: [id, tenantId], onDelete: Cascade)

  triggeredById Int?
  triggeredBy   User? @relation("NotificationTriggeredBy", fields: [triggeredById, tenantId], references: [id, tenantId], onDelete: NoAction)

  leaveId Int?
  leave   Leave? @relation(fields: [leaveId, tenantId], references: [id, tenantId], onDelete: Cascade)

  metadata Json?

  @@index([tenantId, recipientId, isRead])
  @@index([tenantId, triggeredById])
  @@index([tenantId, leaveId])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

////////////////////////
// ENUMS
////////////////////////
enum NotificationType {
  leave_submitted
  leave_approved
  leave_rejected
  system
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuthMode {
  PASSWORD
  SSO
  PASSWORD_AND_SSO
}

enum SsoProvider {
  MICROSOFT_ENTRA_ID
}
