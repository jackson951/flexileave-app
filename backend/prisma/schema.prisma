generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////
// TENANT (COMPANY)
////////////////////////
model Tenant {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  isActive       Boolean  @default(true)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  createdAt      DateTime @default(now())

  users         User[]
  leaves        Leave[]
  notifications Notification[]
  invitations   UserInvitation[]

  @@map("tenants")
}

////////////////////////
// USER
////////////////////////
model User {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                String
  email               String
  phone               String?
  department          String?
  position            String?
  joinDate            DateTime
  reportsToId         Int?
  reportsTo           User?            @relation("UserReportsTo", fields: [reportsToId], references: [id])
  subordinates        User[]           @relation("UserReportsTo")
  incomingInvitations UserInvitation[] @relation("InvitationApprover")
  leaveBalances       Json
  role                Role             @default(EMPLOYEE)
  avatar              String?
  password            String
  createdAt           DateTime         @default(now())
  refreshToken        String?
  status              String           @default("ACTIVE")

  leaves            Leave[]
  actionedLeaves    Leave[] @relation("LeaveActionedBy")
  assignedApprovals Leave[] @relation("LeaveApprover")

  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsTriggered Notification[] @relation("NotificationTriggeredBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([reportsToId])
  @@map("users")
}

////////////////////////
// LEAVE
////////////////////////
model Leave {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leaveType        String
  startDate        DateTime
  endDate          DateTime
  days             Int
  reason           String
  status           LeaveStatus @default(PENDING)
  submittedAt      DateTime    @default(now())
  rejectionReason  String?
  emergencyContact String?
  emergencyPhone   String?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  actionedBy     Int?
  actionedByUser User? @relation("LeaveActionedBy", fields: [actionedBy], references: [id])
  approverId     Int?
  approver       User? @relation("LeaveApprover", fields: [approverId], references: [id])

  attachments   File[]
  notifications Notification[]

  @@index([tenantId])
  @@index([userId])
  @@index([approverId])
  @@map("leaves")
}

////////////////////////
// USER INVITATIONS
////////////////////////
model UserInvitation {
  id Int @id @default(autoincrement())

  email String
  token String @unique
  role  Role

  tenantId   Int
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approverId Int?
  approver   User?  @relation("InvitationApprover", fields: [approverId], references: [id])

  expiresAt    DateTime
  used         Boolean  @default(false)
  passwordHash String?
  metadata     Json?
  createdAt    DateTime @default(now())
  // ❌ REMOVED @@map("user_invitations")

  @@index([tenantId, approverId])
  @@index([tenantId, email])
}

////////////////////////
// FILE ATTACHMENTS
////////////////////////
model File {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  size       Int
  type       String
  uploadedAt DateTime @default(now())

  leaveId Int?
  leave   Leave? @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@map("files")
}

////////////////////////
// NOTIFICATIONS
////////////////////////
model Notification {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  recipientId Int
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  triggeredById Int?
  triggeredBy   User? @relation("NotificationTriggeredBy", fields: [triggeredById], references: [id])

  leaveId Int?
  leave   Leave? @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  metadata Json?

  @@index([tenantId, recipientId, isRead])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

////////////////////////
// ENUMS
////////////////////////
enum NotificationType {
  leave_submitted
  leave_approved
  leave_rejected
  system
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
